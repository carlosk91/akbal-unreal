# ============================================================
# Akbal — Unreal Engine 5.7 (C++)
# Repository root = Unreal project root
# ============================================================

# ############################################################
# Unreal Engine — generated
# ############################################################

Binaries/
DerivedDataCache/
Intermediate/
Saved/

# Legacy nested project generated output (pre-flatten migration)
Akbal/Binaries/
Akbal/DerivedDataCache/
Akbal/Intermediate/
Akbal/Saved/

# Plugins compiled output
Plugins/**/Binaries/
Plugins/**/Intermediate/

# Autosaves and backups
Saved/Autosaves/
Saved/Backup/
Saved/Crashes/
Saved/Logs/
Saved/MaterialStats/
Saved/Temp/

# Lightmass generated data
**/*_BuiltData.uasset

# Build output
Build/*

# Keep important Build packaging files
!Build/*/
!Build/**/*.ico
!Build/*/PakBlacklist*.txt

# Raw/unversioned production workspace
SourceAssets/Raw/

