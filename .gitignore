# ============================================================
# Unreal Engine 5.7 (C++)
# Repositorio:
#   /.git
#   /.gitignore
#   /Akbal
# ============================================================

# ############################################################
# Unreal Engine
# ############################################################

# Carpetas generadas
Akbal/Binaries/
Akbal/DerivedDataCache/
Akbal/Intermediate/
Akbal/Saved/

# Plugins compilados
Akbal/Plugins/**/Binaries/
Akbal/Plugins/**/Intermediate/

# Autosaves y backups
Akbal/Saved/Autosaves/
Akbal/Saved/Backup/
Akbal/Saved/Crashes/
Akbal/Saved/Logs/
Akbal/Saved/MaterialStats/
Akbal/Saved/Temp/

# Archivos generados por Lightmass
Akbal/**/*_BuiltData.uasset

# Source Art (si los PSD/PNG originales viven fuera del proyecto puedes ignorarlos)
Akbal/SourceArt/**/*.png
Akbal/SourceArt/**/*.tga
Akbal/SourceArt/**/*.psd
Akbal/SourceArt/**/*.kra

# Build output
Akbal/Build/*

# Mantener archivos importantes de Build
!Akbal/Build/*/
!Akbal/Build/**/*.ico
!Akbal/Build/*/PakBlacklist*.txt

# ############################################################
# Visual Studio
# ############################################################

.vs/
.vsconfig

*.VC.db
*.VC.opendb

*.sln
*.vcxproj
*.vcxproj.filters
*.vcxproj.user

*.opensdf
*.sdf
*.suo

*.user
*.userprefs
*.userosscache

*.dbmdl
*.jfm
*.sln.docstates

# ############################################################
# Rider / ReSharper
# ############################################################

.idea/
.idea.*/

*.iml
*.sln.iml

_ReSharper*/
_ReSharper.Caches/

*.DotSettings.user

# ############################################################
# VS Code
# ############################################################

.vscode/

# Si quieren compartir launch/tasks/settings,
# comenta la línea anterior y usa:
#
# .vscode/*
# !.vscode/settings.json
# !.vscode/tasks.json
# !.vscode/launch.json
# !.vscode/extensions.json

# ############################################################
# Cursor
# ############################################################

.cursor/
.cursor-cache/

# Si quieren compartir reglas del proyecto,
# comentar las líneas anteriores y usar:
#
# .cursor/*
# !.cursor/rules/
# !.cursor/rules/**
# !.cursorignore

# ############################################################
# Archivos compilados
# ############################################################

*.obj
*.o
*.lo
*.slo

*.pch
*.gch

*.dll
*.lib
*.a
*.so
*.dylib

*.exe
*.app
*.ipa
*.out

# ############################################################
# Live Coding
# ############################################################

*LiveCodingModules.json
*LiveCoding.json

# ############################################################
# Logs
# ############################################################

*.log
*.tmp
*.cache
*.bak

# ############################################################
# Crash Dumps
# ############################################################

*.dmp
*.stackdump

# ############################################################
# Sistemas Operativos
# ############################################################

Thumbs.db
Desktop.ini
.DS_Store

# macOS
.AppleDouble
.LSOverride

# ############################################################
# Git
# ############################################################

.gitmodules~

# ############################################################
# Python
# ############################################################

__pycache__/
*.pyc

# ############################################################
# CMake
# ############################################################

CMakeFiles/
CMakeCache.txt

# ############################################################
# Compilación Linux
# ############################################################

compile_commands.json

# ############################################################
# Archivos temporales
# ############################################################

*.orig
*.rej
*.swp
*.swo

# ############################################################
# NO ignorar estos directorios
# ############################################################

!Akbal/Config/**
!Akbal/Content/**
!Akbal/Plugins/**
!Akbal/Source/**
!Akbal/*.uproject